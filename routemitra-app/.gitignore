# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# sentry
.env.sentry-build-plugin

# local data sources (district list etc.) — not for the repo
*.xlsx

# local data sources for lib/districts.ts + lib/district-hubs.ts (regenerated offline)
list_of_stations.json
list-of-airports-in-india.csv
