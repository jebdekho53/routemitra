# Copy to .env.local and fill in as each provider is approved (see ROUTEMITRA-ROADMAP.md).
# .env.local is gitignored — never commit real keys.
# Every integration is optional: with a var unset the app falls back to sample data.

# --- Phase 3: cache (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- flights: source priority = Duffel > Travelpayouts > sample ---
# Duffel: https://app.duffel.com  (sandbox key = duffel_test_..., real-time)
DUFFEL_API_KEY=
# Travelpayouts / Aviasales: https://www.travelpayouts.com  (free, cached fares,
# you earn commission). TOKEN from dashboard; MARKER makes booking links pay out.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- trains: source priority = RapidAPI irctc1 > generic provider > sample ---
# RapidAPI "irctc1": https://rapidapi.com/IRCTCAPI/api/irctc1  (free tier ~20/mo,
# no fare in this endpoint so fares are estimated + marked indicative)
RAPIDAPI_IRCTC_KEY=
RAPIDAPI_IRCTC_HOST=irctc1.p.rapidapi.com
# generic fallback (any {from}/{to} JSON HTTP provider)
TRAIN_PROVIDER_API_URL=
TRAIN_PROVIDER_API_KEY=
TRAIN_PROVIDER_API_HOST=

# --- bus (RapidAPI interim, then RedBus Seat Seller / GDS) ---
# URL may contain {from} and {to} placeholders (URL-encoded city names).
BUS_PROVIDER_API_URL=
BUS_PROVIDER_API_KEY=
BUS_PROVIDER_API_HOST=

# --- affiliate link wrapping (bus + train deep links only) ---
# Cuelinks: https://www.cuelinks.com  -> CID from dashboard. Wraps RedBus,
# AbhiBus, ConfirmTkt, ixigo, MMT etc via linksredirect.com (commission).
CUELINKS_CID=
# INRDeals: https://inrdeals.com/publisher  -> publisher ID (e.g. urb123456789).
# Fallback used only when CUELINKS_CID is unset. Wraps via inr.deals/track.
INRDEALS_ID=
# Hotellook / Travelpayouts hotel affiliate marker (server-safe copy is fine).
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=

# --- Phase 7: click tracking (Postgres) + analytics ---
# Any Postgres works (driver: node-postgres). Local:
#   postgresql://user:pass@127.0.0.1:5432/routemitra
# Neon/Supabase: their URL + ?sslmode=require  (SSL auto-detected).
# Unset => clicks/errors go to console, auth/dashboard features are disabled.
DATABASE_URL=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Phase 8/9: SEO / deploy ---
NEXT_PUBLIC_SITE_URL=https://routemitra.vercel.app

# --- Phase 11: door-to-door (optional; falls back to free Nominatim + estimate math) ---
GOOGLE_MAPS_API_KEY=
UBER_SERVER_TOKEN=

# --- Phase 15: error monitoring (optional) ---
SENTRY_DSN=

# --- Phase 18: admin dashboard (Basic Auth). Unset => /admin returns 503 ---
ADMIN_USER=
ADMIN_PASSWORD=

# --- Phase 12: auth (Auth.js / NextAuth v5) ---
# Generate: `npx auth secret`  (or: openssl rand -base64 33)
AUTH_SECRET=
# Google login — button only appears when BOTH are set
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Transactional email (verification / reset / price alerts). Unset => emails
# are printed to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=RouteMitra <onboarding@resend.dev>

# --- Phase 13: price-alert cron ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/price-check
CRON_SECRET=

# --- Phase 15: signup CAPTCHA (Cloudflare Turnstile) ---
# Both unset => CAPTCHA skipped (widget hidden, server verification bypassed)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Phase 14: legal identity (Privacy Policy / grievance officer) ---
# Optional. Blank => pages honestly say "pre-incorporation, run by an
# individual founder" instead of showing a fabricated company name/address.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_CIN=
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=
