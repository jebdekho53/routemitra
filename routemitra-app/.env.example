# Copy to .env.local and fill in as each provider is approved (see ROUTEMITRA-ROADMAP.md).
# .env.local is gitignored — never commit real keys.
# Every integration is optional: with a var unset the app falls back to sample data.

# --- Phase 3: cache (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Phase 4: flights (Duffel) ---
# Sandbox key works: https://app.duffel.com  (test airlines, fake fares)
DUFFEL_API_KEY=

# --- Phase 5: bus (RapidAPI interim, then RedBus Seat Seller / GDS) ---
# URL may contain {from} and {to} placeholders (URL-encoded city names).
BUS_PROVIDER_API_URL=
BUS_PROVIDER_API_KEY=
BUS_PROVIDER_API_HOST=

# --- Phase 6: train (RapidAPI IRCTC wrapper interim, then ConfirmTkt / RailYatri PSP) ---
TRAIN_PROVIDER_API_URL=
TRAIN_PROVIDER_API_KEY=
TRAIN_PROVIDER_API_HOST=

# --- Phase 7: click tracking (Postgres — Neon or Supabase) + analytics ---
DATABASE_URL=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Phase 8/9: SEO / deploy ---
NEXT_PUBLIC_SITE_URL=https://routemitra.vercel.app

# --- Phase 11: door-to-door (optional; falls back to free Nominatim + estimate math) ---
GOOGLE_MAPS_API_KEY=
UBER_SERVER_TOKEN=

# --- Phase 15: error monitoring (optional) ---
SENTRY_DSN=

# --- Phase 18: admin dashboard (Basic Auth). Unset => /admin returns 503 ---
ADMIN_USER=
ADMIN_PASSWORD=

# --- Phase 12: auth (Auth.js / NextAuth v5) ---
# Generate: `npx auth secret`  (or: openssl rand -base64 33)
AUTH_SECRET=
# Google login — button only appears when BOTH are set
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Transactional email (verification / reset / price alerts). Unset => emails
# are printed to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=RouteMitra <onboarding@resend.dev>

# --- Phase 13: price-alert cron ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/price-check
CRON_SECRET=

# --- Phase 15: signup CAPTCHA (Cloudflare Turnstile) ---
# Both unset => CAPTCHA skipped (widget hidden, server verification bypassed)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Phase 14: legal identity (Privacy Policy / grievance officer) ---
# Optional. Blank => pages honestly say "pre-incorporation, run by an
# individual founder" instead of showing a fabricated company name/address.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=
